### ============================================================================
### 三、写作 writing（主观链路，交卷后是 GRADING 不是 READY）
### ============================================================================

### 31 写作 · U3 取板块
GET {{practice}}/hsk/papers/{{paperId}}/parts?module=writing&version={{version}}
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    var d = response.body.data;
    if (response.body.code === 200 && d.parts && d.parts.length) {
        client.global.set("wrSection", String(d.parts[0].section));
        client.log("写作板块 section=" + d.parts[0].section +
                   " 题型=" + d.parts[0].typeName);
    } else {
        client.log("该卷没有写作板块，请换 paperId");
    }
%}


### 32 写作 · 开练（三字段必填）
POST {{practice}}/writing/records/start
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "paperId": {{paperId}},
  "sectionMapping": "SEC_WRITE",
  "section": "{{wrSection}}"
}

> {%
    client.test("写作开练成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code +
                      " message=" + response.body.message);
    });
    client.global.set("wrRecordId", String(response.body.data.recordId));
    client.log("recordId=" + response.body.data.recordId +
               " status=" + response.body.data.status +
               " reportStatus=" + response.body.data.reportStatus);
%}


### 33 写作 · 拉题（看 layout 与 answerDraft）
GET {{practice}}/writing/records/{{wrRecordId}}/questions
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("写作题目可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var q = response.body.data[0];
    client.global.set("wrQuestionId", String(q.questionId));
    client.log("layout=" + q.layout + " hasStandardAnswer=" + q.hasStandardAnswer +
               " answerDraft=" + JSON.stringify(q.answerDraft));
%}


### 34 写作 · 存草稿（整份覆盖；同内容不增版本）
PUT {{practice}}/writing/records/{{wrRecordId}}/questions/{{wrQuestionId}}/draft
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "text": "我上周未去公园，天气很好，我们一家人一起散步……"
}

> {%
    client.test("草稿保存成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code +
                      " message=" + response.body.message);
    });
    client.global.set("wrDraftVersion", response.body.data.version);
    client.log("version=" + response.body.data.version +
               " 字素=" + response.body.data.graphemeCount);
%}


### 35 写作 · 再存一次同内容（版本应不变）
PUT {{practice}}/writing/records/{{wrRecordId}}/questions/{{wrQuestionId}}/draft
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "text": "我上周未去公园，天气很好，我们一家人一起散步……",
  "expectedVersion": {{wrDraftVersion}}
}

> {%
    client.test("同内容不增版本", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
        client.assert(response.body.data.version === {{wrDraftVersion}},
                      "版本变了：" + response.body.data.version);
    });
    client.log("version=" + response.body.data.version + "（应与上次相同）");
%}


### 36 写作 · 正式保存答案（草稿不会自动变答案）
PUT {{practice}}/writing/records/{{wrRecordId}}/answers
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "answers": [
    {
      "questionId": {{wrQuestionId}},
      "answerText": "我上周未去公园，天气很好，我们一家人一起散步，看到了很多花……"
    }
  ],
  "currentQuestionId": {{wrQuestionId}}
}

> {%
    client.test("写作答案保存成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.log("已答=" + response.body.data.answeredCount);
%}


### 37 写作 · 答题卡
GET {{practice}}/writing/records/{{wrRecordId}}/answer-card
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("写作答题卡正常", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
%}


### 38 写作 · 交卷
POST {{practice}}/writing/records/{{wrRecordId}}/submit
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "finalAnswers": [
    {
      "questionId": {{wrQuestionId}},
      "answerText": "我上周未去公园，天气很好，我们一家人一起散步，看到了很多花……"
    }
  ],
  "durationSeconds": 300
}

> {%
    client.test("写作交卷成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var d = response.body.data;
    client.log("status=" + d.status + " reportStatus=" + d.reportStatus +
               " draftNotSubmitted=" + JSON.stringify(d.draftNotSubmitted) +
               " idempotencyKey=" + d.idempotencyKey);
%}


### 39 写作 · 报告（AI 评分总开关关着时恒为 GRADING）
GET {{practice}}/writing/records/{{wrRecordId}}/report
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("写作报告可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var d = response.body.data;
    client.log("reportStatus=" + d.reportStatus +
               " 已评=" + d.aiScoredCount + "/" + d.aiQuestionCount +
               " 得分=" + d.finalScore + "/" + d.totalScore);
    if (d.reportStatus === "GRADING") {
        client.log("提示：AI 评分仍在进行（或 grading.enabled=false），需轮询");
    }
%}


### 3A 写作 · 报告重试（仅 FAILED 时有意义）
POST {{practice}}/writing/records/{{wrRecordId}}/report/retry
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("重试接口可调", function () {
        client.assert(response.body.code === 200 || response.body.code === 400,
                      "code=" + response.body.code);
    });
    client.log("reportStatus=" + (response.body.data || {}).reportStatus +
               " message=" + response.body.message);
%}

### ============================================================================
### 四、翻译 translation（交卷路名是 /submissions）
### ============================================================================

### 41 翻译 · U3 取板块（section=1 笔译 / 2 口译）
GET {{practice}}/hsk/papers/{{paperId}}/parts?module=translation&version={{version}}
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    var d = response.body.data;
    if (response.body.code === 200 && d.parts && d.parts.length) {
        client.global.set("trSection", String(d.parts[0].section));
        client.log("翻译板块 section=" + d.parts[0].section +
                   "（1=笔译 input，2=口译 record）");
    } else {
        client.log("该卷没有翻译板块（2.0 卷没有翻译），请把 @version 改成 HSK3.0");
    }
%}


### 42 翻译 · 开练
POST {{practice}}/translation/records/start
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "paperId": {{paperId}},
  "sectionMapping": "SEC_TRANSLATION",
  "section": "{{trSection}}"
}

> {%
    client.test("翻译开练成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.global.set("trRecordId", String(response.body.data.recordId));
    client.log("recordId=" + response.body.data.recordId +
               " sectionMapping=" + response.body.data.sectionMapping);
%}


### 43 翻译 · 拉题
GET {{practice}}/translation/records/{{trRecordId}}/questions
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("翻译题目可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var q = response.body.data[0];
    client.global.set("trQuestionId", String(q.questionId));
    client.log("layout=" + q.layout + "（input=笔译，record=口译）" +
               " content=" + (q.content || "").substring(0, 40));
%}


### 44 翻译 · 保存答案
PUT {{practice}}/translation/records/{{trRecordId}}/answers
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "answers": [
    { "questionId": {{trQuestionId}}, "answerText": "The weather is very good today." }
  ],
  "currentQuestionId": {{trQuestionId}}
}

> {%
    client.test("翻译答案保存成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
%}


