### ============================================================================
### HSK 练习 · 五模块全链路联调脚本（Idea HTTP Client）
###
### 用法：从上到下依次点绿色箭头执行，变量会自动串联。
###   1. 先改下面 @username / @password 为你的测试账号
###   2. 选一个 @practice 目标：
###        经网关：    @practice = http://<网关地址>/api/practice
###        本地直连：  @practice = http://127.0.0.1:8087
###   3. 从「00 登录」开始跑
###
### 注意：@practice 用本地直连时，登录那一步的 @auth 也要改成 auth-service 的
###       本地端口（默认 8081），且路径去掉 /api：http://127.0.0.1:8081
###
### 每个请求上的 X-Client-Type: APP 不能删 —— 删了服务端会用内置的 userId=1
### 模拟用户跑，不报错但数据不对。
###
### ⚠️ 关于 19 位 ID：脚本用 client.global.set 自动串联 paperId / recordId。
###    如果脚本引擎把大整数转成 double，尾数会变成 ...000，接口随即报 403。
###    每个 client.log 都打印了 ID，跑之前扫一眼末尾是不是全 0 —— 是的话
###    就从响应 JSON 里手动复制真实 ID，替换对应请求里的 {{...}}。
### ============================================================================

@practice = http://127.0.0.1:8087
@auth = http://127.0.0.1:8081
@username = 13800000000
@password = 123456
@version = HSK3.0
@level = 3
@module = listening


### 00 登录：拿 token
POST {{auth}}/app/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
    client.test("登录成功", function () {
        client.assert(response.body.code === 200, "登录失败: " + JSON.stringify(response.body));
        client.assert(!!response.body.data.token, "响应里没有 token");
    });
    client.global.set("token", response.body.data.token);
    client.log("token 已写入 token 变量");
%}


### 01 首页模块卡（免登录，不需要 token）
GET {{practice}}/hsk/modules?version={{version}}
Accept-Language: zh

> {%
    client.test("拿到模块卡", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
        client.assert(response.body.data.modules.length > 0, "modules 为空");
    });
    client.log("layout=" + response.body.data.layout +
               " 模块数=" + response.body.data.modules.length);
%}


### 02 U1 等级概览 + 卷列表 → 取第一张卷的 paperId
GET {{practice}}/hsk/levels?module={{module}}&version={{version}}&level={{level}}
X-Client-Type: APP
Authorization: Bearer {{token}}
Accept-Language: zh

> {%
    client.test("拿到卷列表", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
        client.assert(response.body.data.paperCount > 0,
                      "该等级没有卷，换个 level 或 module 再试");
    });
    // paperId 是 19 位 Long，直接转字符串存，避免 JS 精度丢失
    var pid = String(response.body.data.papers[0].paperId);
    client.global.set("paperId", pid);
    client.log("paperId=" + pid + "  卷名=" + response.body.data.papers[0].paperCode +
               "  状态=" + response.body.data.papers[0].status);
%}


### 03 U2 等级备考说明（展示用，无进度）
GET {{practice}}/hsk/levels/{{level}}/intro?module={{module}}&version={{version}}
X-Client-Type: APP
Authorization: Bearer {{token}}
Accept-Language: zh

> {%
    client.test("拿到备考说明", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.log("总题量=" + response.body.data.totalQuestionCount +
               " 时长=" + response.body.data.durationMinutes + "分钟" +
               " 板块数=" + response.body.data.parts.length);
%}


### 04 U3 卷内板块 + 进度 → 取第一个板块的 section
GET {{practice}}/hsk/papers/{{paperId}}/parts?module={{module}}&version={{version}}
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("拿到板块", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
        client.assert(response.body.data.parts.length > 0, "该卷没有此模块的板块");
    });
    var p = response.body.data.parts[0];
    client.global.set("section", String(p.section));
    client.log("section=" + p.section + " (" + typeof p.section + ")" +
               " partCode=" + p.partCode +
               " 状态=" + p.status +
               " 已答=" + p.doneCount + "/" + p.questionCount);
    if (p.draft) {
        client.log("有草稿: answeredCount=" + p.draft.answeredCount +
                   " currentQuestionId=" + p.draft.currentQuestionId);
    }
%}

### ============================================================================
### 一、听力 listening
### ============================================================================

### 11 听力 · 开练（幂等：已有进行中记录会直接返回）
POST {{practice}}/listening/records/start
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "paperId": {{paperId}},
  "section": "{{section}}",
  "restart": false
}

> {%
    client.test("开练成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code +
                      " message=" + response.body.message);
    });
    var d = response.body.data;
    client.global.set("lisRecordId", String(d.recordId));
    client.log("recordId=" + d.recordId + " status=" + d.status +
               " 进度=" + d.answeredCount + "/" + d.totalQuestions);
%}


### 12 听力 · 拉题 → 取第一题
GET {{practice}}/listening/records/{{lisRecordId}}/questions
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("拉到题目", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
        client.assert(response.body.data.length > 0, "题目为空");
    });
    var q = response.body.data[0];
    client.global.set("lisQuestionId", String(q.questionId));
    var opts = q.option_content ? Object.keys(q.option_content) : [];
    client.global.set("lisOption", opts.length ? opts[0] : "A");
    client.log("qid=" + q.questionId + " layout=" + q.layout +
               " 选项键=" + JSON.stringify(opts) +
               " audio_url=" + q.audio_url);
%}


### 13 听力 · 单题保存（防抖，选完就存）
PUT {{practice}}/listening/records/{{lisRecordId}}/answers/{{lisQuestionId}}
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "selectedOptionId": "{{lisOption}}",
  "clientSequence": 1
}

> {%
    client.test("单题保存成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.log("answer=" + response.body.data.answer +
               " conflict=" + response.body.data.conflict +
               " currentVersion=" + response.body.data.currentVersion);
%}


### 14 听力 · 批量保存（切题/退出时）
PUT {{practice}}/listening/records/{{lisRecordId}}/answers
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "answers": [
    { "questionId": {{lisQuestionId}}, "selectedOptionId": "{{lisOption}}" }
  ],
  "currentQuestionId": {{lisQuestionId}},
  "durationSeconds": 30
}

> {%
    client.test("批量保存成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.log("已答=" + response.body.data.answeredCount +
               "/" + response.body.data.totalQuestions);
%}


### 15 听力 · 暂停（存进度 + 草稿答案）
POST {{practice}}/listening/records/{{lisRecordId}}/pause
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "currentQuestionId": {{lisQuestionId}},
  "durationSeconds": 60,
  "draftAnswers": [
    { "questionId": {{lisQuestionId}}, "answer": "{{lisOption}}", "answered": 1 }
  ]
}

> {%
    client.test("暂停成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
%}


### 16 听力 · 答题卡
GET {{practice}}/listening/records/{{lisRecordId}}/answer-card
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("答题卡正常", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var d = response.body.data;
    client.log("总题=" + d.totalQuestions + " 已答=" + d.answeredCount +
               " 未答=" + d.unansweredCount + " 当前题号=" + d.currentQuestionNumber);
%}


### 17 听力 · 交卷（客观题，立刻出报告）
POST {{practice}}/listening/records/{{lisRecordId}}/submit
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "durationSeconds": 120,
  "finalAnswers": [
    { "questionId": {{lisQuestionId}}, "selectedOptionId": "{{lisOption}}" }
  ]
}

> {%
    client.test("交卷成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var d = response.body.data;
    client.log("reportStatus=" + d.reportStatus + " 正确率=" + d.accuracyRate +
               " 对=" + d.correctCount + " 错=" + d.wrongCount);
%}


### 18 听力 · 报告详情
GET {{practice}}/listening/records/{{lisRecordId}}/report
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("报告可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.log("reportStatus=" + response.body.data.reportStatus +
               " 行数=" + (response.body.data.rows || []).length);
%}


### 19 听力 · 单题回顾
GET {{practice}}/listening/records/{{lisRecordId}}/report/questions/{{lisQuestionId}}
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("单题回顾可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.log("userAnswer=" + response.body.data.userAnswer +
               " standardAnswer=" + response.body.data.standardAnswer +
               " isCorrect=" + response.body.data.isCorrect);
%}

### ============================================================================
### 二、阅读 reading
### ============================================================================

### 21 阅读 · 切模块重取 paperId + section
GET {{practice}}/hsk/papers/{{paperId}}/parts?module=reading&version={{version}}
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    var d = response.body.data;
    if (response.body.code === 200 && d.parts && d.parts.length) {
        client.global.set("rdSection", String(d.parts[0].section));
        client.log("阅读板块 section=" + d.parts[0].section);
    } else {
        client.log("该卷没有阅读板块，请换 paperId");
    }
%}


### 22 阅读 · 开练
POST {{practice}}/reading/records/start
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "paperId": {{paperId}},
  "section": "{{rdSection}}",
  "restart": false
}

> {%
    client.test("阅读开练成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.global.set("rdRecordId", String(response.body.data.recordId));
    client.log("recordId=" + response.body.data.recordId +
               " 进度=" + response.body.data.answeredCount + "/" + response.body.data.totalQuestions);
%}


### 23 阅读 · 拉题（注意 optionContent.options 多一层）
GET {{practice}}/reading/records/{{rdRecordId}}/questions
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("阅读题目可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var q = response.body.data[0];
    client.global.set("rdQuestionId", String(q.questionId));
    var opts = q.optionContent && q.optionContent.options ? Object.keys(q.optionContent.options) : [];
    client.global.set("rdOption", opts.length ? opts[0] : "A");
    client.log("number=" + q.number + " 选项键(在 options 里)=" + JSON.stringify(opts) +
               " groupId=" + q.groupId);
%}


### 24 阅读 · 单题保存
PUT {{practice}}/reading/records/{{rdRecordId}}/answers/{{rdQuestionId}}
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "questionId": {{rdQuestionId}},
  "answer": "{{rdOption}}"
}

> {%
    client.test("阅读单题保存成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
%}


