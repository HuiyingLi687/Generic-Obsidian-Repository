### ============================================================================
### 五、口语 speaking（音频作答，录音上传端点已停用）
### ============================================================================

### 51 口语 · U3 取板块
GET {{practice}}/hsk/papers/{{paperId}}/parts?module=speaking&version={{version}}
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    var d = response.body.data;
    if (response.body.code === 200 && d.parts && d.parts.length) {
        client.global.set("spSection", String(d.parts[0].section));
        client.log("口语板块 section=" + d.parts[0].section +
                   " partCode=" + d.parts[0].partCode);
    } else {
        client.log("该卷没有口语板块，请换 paperId");
    }
%}


### 52 口语 · 开练（sectionMapping 用 SEC_SPEAKING）
POST {{practice}}/speaking/records/start
Content-Type: application/json
X-Client-Type: APP
Authorization: Bearer {{token}}

{
  "paperId": {{paperId}},
  "sectionMapping": "SEC_SPEAKING",
  "section": "{{spSection}}"
}

> {%
    client.test("口语开练成功", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    client.global.set("spRecordId", String(response.body.data.recordId));
    client.log("recordId=" + response.body.data.recordId +
               " sectionMapping=" + response.body.data.sectionMapping +
               "（服务端返回 SEC_SPEAKING）");
%}


### 53 口语 · 拉题（layout 恒 record，题目本体常在 passage）
GET {{practice}}/speaking/records/{{spRecordId}}/questions
X-Client-Type: APP
Authorization: Bearer {{token}}

> {%
    client.test("口语题目可读", function () {
        client.assert(response.body.code === 200, "code=" + response.body.code);
    });
    var q = response.body.data[0];
    client.global.set("spQuestionId", String(q.questionId));
    client.log("layout=" + q.layout + "（应恒为 record）" +
               " hasStandardAnswer=" + q.hasStandardAnswer +
               " passage=" + (q.passage || "").substring(0, 40));
%}


